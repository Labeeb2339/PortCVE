{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portcve:schema:verify:v1",
  "title": "PortCVE exposure verification v1",
  "description": "Imported scanner evidence correlated with live Windows listener ownership. Correlation does not establish current reachability, vulnerability applicability, or exploitability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "privacy_mode",
    "generated_at",
    "association",
    "inputs",
    "endpoints",
    "target_findings",
    "summary",
    "diagnostics",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "privacy_mode": { "enum": ["private", "reduced"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "association": { "$ref": "#/$defs/association" },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/input" }
    },
    "endpoints": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "target_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_group" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imported_target", "association_asserted", "vantage", "port_mappings"],
      "properties": {
        "imported_target": { "type": "string", "minLength": 1 },
        "association_asserted": { "const": true },
        "vantage": { "type": "string", "minLength": 1, "maxLength": 64 },
        "port_mappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/port_mapping" }
        }
      }
    },
    "port_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "external_port", "local_port"],
      "properties": {
        "protocol": { "enum": ["tcp", "udp"] },
        "external_port": { "$ref": "#/$defs/port" },
        "local_port": { "$ref": "#/$defs/port" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "is_complete"],
      "properties": {
        "source": { "enum": ["nmap_xml", "nuclei_jsonl", "nessus_xml", "live_windows"] },
        "file_name": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_version": { "type": "string", "minLength": 1 },
        "is_complete": { "type": "boolean" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "external_port",
        "local_port",
        "correlation",
        "outside_observations",
        "local_listeners",
        "findings",
        "limitations"
      ],
      "properties": {
        "protocol": { "enum": ["tcp", "udp"] },
        "external_port": { "$ref": "#/$defs/port" },
        "local_port": { "$ref": "#/$defs/port" },
        "correlation": {
          "enum": [
            "correlated_open",
            "outside_only",
            "loopback_mismatch",
            "outside_negative_local_present",
            "consistent_absent",
            "inconclusive"
          ]
        },
        "outside_observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outside_observation" }
        },
        "local_listeners": {
          "type": "array",
          "items": { "$ref": "#/$defs/local_listener" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding_group" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outside_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "state"],
      "properties": {
        "source": { "enum": ["nmap_xml"] },
        "target": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["open", "closed", "filtered", "unfiltered", "open|filtered", "closed|filtered", "unknown"]
        },
        "state_reason": { "type": "string", "minLength": 1 },
        "service": { "$ref": "#/$defs/service" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpes", "evidence_strength", "evidence_source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "extra_info": { "type": "string", "minLength": 1 },
        "cpes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_strength": {
          "enum": ["direct", "strong", "moderate", "weak", "conflicting", "unresolved"]
        },
        "evidence_source": { "type": "string", "minLength": 1 }
      }
    },
    "local_listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "bind_scope",
        "local_address",
        "local_port",
        "owner_identity",
        "owner_identity_strength",
        "image_name",
        "services",
        "container_images",
        "host_policy",
        "host_policy_confidence",
        "limitations"
      ],
      "properties": {
        "family": { "enum": ["ipv4", "ipv6"] },
        "bind_scope": { "enum": ["loopback", "interface", "wildcard", "unknown"] },
        "local_address": { "type": "string", "minLength": 1 },
        "local_port": { "$ref": "#/$defs/port" },
        "owner_identity": { "type": "string", "minLength": 1 },
        "owner_identity_strength": {
          "enum": ["sha256", "container_image", "service", "kernel", "name_only", "unknown"]
        },
        "image_name": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "container_images": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "host_policy": { "enum": ["not_evaluated", "allow", "block", "mixed", "unknown", "disabled"] },
        "host_policy_confidence": { "enum": ["high", "medium", "low"] },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "finding_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_group_id",
        "title",
        "highest_reported_severity",
        "advisory_ids",
        "correlation",
        "exploitability",
        "observations"
      ],
      "properties": {
        "finding_group_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "highest_reported_severity": { "$ref": "#/$defs/severity" },
        "advisory_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "correlation": { "enum": ["owner_corroborated", "owner_ambiguous", "scanner_only", "inconclusive"] },
        "exploitability": { "const": "not_assessed" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finding_observation" }
        }
      }
    },
    "finding_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "finding_id",
        "title",
        "severity",
        "claim_status",
        "evidence_strength",
        "advisory_ids",
        "source_record_sha256"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "claim_status": { "enum": ["observed", "candidate", "imported_match", "inconclusive"] },
        "evidence_strength": {
          "enum": ["direct", "strong", "moderate", "weak", "conflicting", "unresolved"]
        },
        "advisory_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "matcher": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outside_endpoint_count",
        "outside_open_count",
        "correlated_open_count",
        "outside_only_count",
        "loopback_mismatch_count",
        "outside_negative_local_present_count",
        "consistent_absent_count",
        "inconclusive_count",
        "finding_group_count",
        "critical_count",
        "high_count",
        "is_complete"
      ],
      "properties": {
        "outside_endpoint_count": { "type": "integer", "minimum": 0 },
        "outside_open_count": { "type": "integer", "minimum": 0 },
        "correlated_open_count": { "type": "integer", "minimum": 0 },
        "outside_only_count": { "type": "integer", "minimum": 0 },
        "loopback_mismatch_count": { "type": "integer", "minimum": 0 },
        "outside_negative_local_present_count": { "type": "integer", "minimum": 0 },
        "consistent_absent_count": { "type": "integer", "minimum": 0 },
        "inconclusive_count": { "type": "integer", "minimum": 0 },
        "finding_group_count": { "type": "integer", "minimum": 0 },
        "critical_count": { "type": "integer", "minimum": 0 },
        "high_count": { "type": "integer", "minimum": 0 },
        "is_complete": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "severity": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
